{
  "name": "dsh-memory-nebula",
  "version": "0.4.0",
  "description": "Cross-device memory nebula: fuzzy retrieval, tiered memories that never fade, gradual compression, and an interactive star map.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "memory",
    "plugin"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raging007/memory-nebula-kit.git"
  }
}
